[Unit]
Description=SmartFeedback AI
After=network.target

[Service]
Type=exec
User=root
WorkingDirectory=/root/smartfeedback-ai
EnvironmentFile=/root/smartfeedback-ai/.env
ExecStart=/root/smartfeedback-ai/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
