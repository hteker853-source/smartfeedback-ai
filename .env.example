# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- CALL-E (voice) ---
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
# Public HTTPS base URL where CALL-E should deliver webhooks (e.g. https://your-server.example.com)
CALLE_WEBHOOK_BASE_URL=

# --- AWS Bedrock (agent LLM) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Bedrock Converse model (Nova/Llama; Claude not required)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# --- DeepSeek (OpenAI-compatible model provider) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Google Gemini (third, independent model provider) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Agent model provider: "gemini" (default), "bedrock", or "deepseek".
# Bedrock/Gemini each fall back to DeepSeek on build failure (never crash the
# pipeline). All three provider code paths are always present; this is a
# runtime switch, not an architectural choice.
LLM_PROVIDER=gemini

# --- Application ---
DATABASE_PATH=data/smartfeedback.db
BUSINESS_NAME=SmartFeedback Demo
BUSINESS_DEFAULT_LOCALE=tr
# Gelecekte farklı BUSINESS_TYPE değerleri (örn. "appointment_reminder",
# "subscription_renewal") farklı tetikleme mantığı kullanabilir; şu an sadece
# "order_fulfillment" uygulanmıştır. Bu alan henüz hiçbir mantığı DALLANDIRMIYOR.
BUSINESS_TYPE=order_fulfillment
POST_DELIVERY_DELAY_MINUTES=30
BUSINESS_CLOSE_HOUR=2
MORNING_SUMMARY_HOUR=8
# IANA timezone for close/morning-summary hour scheduling (e.g. Europe/Istanbul)
BUSINESS_TIMEZONE=UTC
# Raw transcript retention in days (0 = keep forever). Structured data is kept.
RAW_TRANSCRIPT_RETENTION_DAYS=90
# Comma-separated ISO-3166 regions this deployment may call (e.g. "US,GB").
# Empty = rely on CALL-E's own region/language validation (recommended; CALL-E
# applies temporary regional restrictions that cannot be known locally).
# Full supported list: https://docs.heycall-e.com/regions
SUPPORTED_CALL_REGIONS=
# Deployment environment tag carried in CALL-E call metadata (e.g. dev/prod).
ENVIRONMENT=dev
# Optional shared token guarding mutating API endpoints (empty = disabled).
API_TOKEN=
# Deterministic policy gate thresholds.
# Minimum aggregated confidence required for an autonomous alert (0..1).
MIN_ALERT_CONFIDENCE=0.6
# Number of occurrences for a canonical problem to be treated as recurring.
RECURRING_THRESHOLD=3
# GÖREV F: flag a "frequency drop" risk once time-since-last-order reaches
# this multiple of the customer's OWN historical average ordering interval.
FREQUENCY_DROP_RATIO_THRESHOLD=2.0
# Minimum past orders needed to compute a customer's normal rhythm at all.
FREQUENCY_DROP_MIN_ORDERS=4
# Downstream action executor: sandbox/test webhook receiver for HUMAN-APPROVED
# actions only. Empty (default) = OFF. Demo/sandbox side-effect channel; never
# enabled in production by accident.
SANDBOX_ACTION_WEBHOOK_URL=
SANDBOX_ACTION_TIMEOUT_SECONDS=5.0
# Database backup directory (empty = no automatic daily backups).
BACKUP_DIR=backups
# Number of database backup files to keep.
BACKUP_KEEP=7
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
